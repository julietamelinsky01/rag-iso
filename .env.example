# Copiá este archivo como .env y completá los valores

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # "service_role" key (secreta, no subir a GitHub)

# OpenAI (se usa para los embeddings y, por defecto, para responder)
OPENAI_API_KEY=sk-...

# Opcional: usar Claude para redactar las respuestas
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
